<?xml version="1.0" encoding="UTF-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fundo semitransparente (cinza esmaecido) -->
    <solid android:color="#80FFFFFF" /> <!-- #80 é a opacidade (50% transparência), e B0BEC5 é a cor cinza -->

    <!-- Configuração da borda -->
    <stroke
        android:width="2dp"
        android:color="#3e4066" /> <!-- Cor da borda -->

    <!-- Configuração dos cantos arredondados -->
    <corners android:radius="12dp" />

    <!-- Padding interno (opcional) -->
    <padding
        android:bottom="16dp"
        android:left="24dp"
        android:right="24dp"
        android:top="16dp" />
</shape>