<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/ivImagem"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do Exercício"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/ivImagem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvObs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Observações"
            android:textSize="14sp"
            android:paddingTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvNome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnEditar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_add_24"
            android:background="@drawable/background_botao_limpar"
            android:backgroundTint="@color/green"
            android:contentDescription="Editar"
            android:layout_marginStart="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvObs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="8dp" />


        <ImageButton
            android:id="@+id/btnDeletar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/background_selecionar"
            android:backgroundTint="@color/red"
            android:src="@drawable/baseline_delete_24"
            android:contentDescription="Excluir"
            app:layout_constraintTop_toTopOf="@id/btnEditar"
            app:layout_constraintBottom_toBottomOf="@id/btnEditar"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
